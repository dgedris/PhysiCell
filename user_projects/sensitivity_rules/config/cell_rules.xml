            <mediator>neutral</mediator>
            <increasing_signals>
                <aggregator>first</aggregator>
                <max_response>1</max_response>
                <signal name="current cycle phase index" type="heaviside">
                    <threshold>1.01</threshold>
                    <applies_to_dead>0</applies_to_dead>
                </signal>
            </increasing_signals>
        </behavior>
